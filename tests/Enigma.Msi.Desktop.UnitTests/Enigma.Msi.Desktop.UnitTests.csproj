<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the app under test; the app is net10.0 alone, so this suite is too. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- The only suite that substitutes: the app's ViewModels talk to the control library's services
         and to the build client, none of which a unit test may drive for real. -->
    <PackageReference Include="NSubstitute" />
    <!-- The only suite with a UI dependency: SplashWindowTests loads the real markup, which needs a
         windowing platform. Avalonia.Headless is one with no screen behind it, and
         Avalonia.Headless.XUnit runs an [AvaloniaFact] body on that platform's own UI thread. Both are
         part of the version-coupled Avalonia set pinned in Directory.Packages.props. -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.Msi.Desktop/Enigma.Msi.Desktop.csproj" />
  </ItemGroup>
</Project>
