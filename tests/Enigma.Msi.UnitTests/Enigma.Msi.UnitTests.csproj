<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirror the TFMs of the library under test, minus netstandard2.0 (not a runtime): net8.0
         exercises the netstandard2.0 polyfill surface reachable through it, net10.0 the current LTS. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.Msi/Enigma.Msi.csproj" />
    <!-- Build-order only: the stub worker is spawned as an external process, never linked against. -->
    <ProjectReference Include="../Enigma.Msi.StubWorker/Enigma.Msi.StubWorker.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>
  <!-- The build client's own copy target, put to work: it places the stub worker in a folder beside the
       test output exactly as it will place the real worker beside the Desktop app, so the mechanism
       PHASE05 depends on is exercised by every build rather than only by inspection. A folder name of
       its own keeps it distinguishable from a real deployed worker. -->
  <PropertyGroup>
    <EnigmaMsiWorkerSourceDir>$(MSBuildThisFileDirectory)../Enigma.Msi.StubWorker/bin/$(Configuration)/net8.0/</EnigmaMsiWorkerSourceDir>
    <EnigmaMsiWorkerFolderName>stub-worker</EnigmaMsiWorkerFolderName>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../build/CopyWorkerOutput.targets" />
</Project>
