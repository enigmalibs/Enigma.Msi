<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the TFM of the code under test rather than the house net10.0 test default: the drift
         guards only mean something when they reflect over the very WixSharp assemblies the worker
         binds to, and those load on .NET Framework only. -->
    <TargetFramework>net472</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <!-- Same reason as the worker: transitive System.Text.Json assembly versions need redirects. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- coverlet.collector is deliberately omitted here (the library suite carries it): it ships build
         assets for net8.0+ only, so referencing it from net472 restores against a non-matching
         framework and raises NU1701, which the zero-warnings build turns into an error. -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.Msi.Worker/Enigma.Msi.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The worker's own output directory — the path build/CopyWorkerOutput.targets copies from by default —
         stamped into the test assembly for WixSharpBuildDirTests: the worker seeds its .wixsharp folder
         there, and this project's output only receives the worker's assemblies, not that folder. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EnigmaMsiWorkerOutputDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../src/Enigma.Msi.Worker/bin/$(Configuration)/net472/</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
