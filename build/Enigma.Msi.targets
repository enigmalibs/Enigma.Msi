<Project>

  <!--
    Shipped inside the Enigma.Msi NuGet package as build/Enigma.Msi.targets, where NuGet imports it
    into every consuming project automatically.

    Its one job: put the net472 worker where the library looks for it. MsiBuildService discovers the
    worker at AppContext.BaseDirectory/worker/Enigma.Msi.Worker.exe, so the package's tools/worker/
    payload has to land in the consumer's output — otherwise every BuildAsync call fails with
    "the MSI worker was not found".

    The copy is expressed as None items carrying CopyToOutputDirectory rather than as a Copy task in an
    AfterTargets="Build" target. That is deliberate: an AfterTargets="Build" copy writes into $(OutDir)
    and is invisible to `dotnet publish`, which assembles $(PublishDir) from the item lists — the exact
    gap the predecessor project shipped with. Items are honoured by both pipelines.

    Consumers can opt out with <IncludeEnigmaMsiWorker>false</IncludeEnigmaMsiWorker> (for a project
    that never builds an MSI but references the model), or rename the destination folder with
    <EnigmaMsiWorkerFolderName>, matching MsiBuildServiceOptions.WorkerPath.
  -->

  <PropertyGroup>
    <EnigmaMsiWorkerFolderName Condition="'$(EnigmaMsiWorkerFolderName)' == ''">worker</EnigmaMsiWorkerFolderName>
    <!-- $(MSBuildThisFileDirectory) is the package's build/ folder; the payload sits next to it. -->
    <_EnigmaMsiWorkerPackageDir>$(MSBuildThisFileDirectory)../tools/worker/</_EnigmaMsiWorkerPackageDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeEnigmaMsiWorker)' != 'false' AND Exists('$(_EnigmaMsiWorkerPackageDir)')">
    <None Include="$(_EnigmaMsiWorkerPackageDir)**/*">
      <!-- Link is what gives a file from outside the project cone its path in the output. -->
      <Link>$(EnigmaMsiWorkerFolderName)/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- The worker belongs to this package; a consumer packing their own must not re-embed it. -->
      <Pack>false</Pack>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
