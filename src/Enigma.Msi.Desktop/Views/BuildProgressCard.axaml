<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:views="using:Enigma.Msi.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="180"
             x:Class="Enigma.Msi.Desktop.Views.BuildProgressCard">
  <!-- Fixed width: the message line is elided rather than allowed to resize the card, so a long WiX
       path does not make the overlay jump around while lines stream in. -->
  <Border Width="400"
          Padding="20"
          CornerRadius="8"
          BorderThickness="1"
          Background="{DynamicResource EnigmaSurfaceBrush}"
          BorderBrush="{DynamicResource EnigmaBorderBrush}">
    <StackPanel Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ei:Icon Kind="Hammer" VerticalAlignment="Center" />
        <TextBlock Text="Building MSI…"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" />

      <TextBlock Text="{Binding $parent[views:BuildProgressCard].Message}"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}"
                 FontSize="11" />

      <Button Content="Cancel"
              HorizontalAlignment="Right"
              Command="{Binding $parent[views:BuildProgressCard].CancelCommand}" />
    </StackPanel>
  </Border>
</UserControl>
